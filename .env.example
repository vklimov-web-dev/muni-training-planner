# Pooled connection used by the application at runtime (Neon host contains `-pooler`).
DATABASE_URL="postgresql://user:password@project-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection used by Prisma CLI for schema migrations.
DIRECT_URL="postgresql://user:password@project.eu-central-1.aws.neon.tech/neondb?sslmode=require"
